extends SceneTree
## v0.04 offline, deterministic economy simulation (no scene, no autoloads).
##
##   godot --headless --path . --script res://tests/sim/economy_sim.gd [-- --write-report]
##
## Plays 500 rides for four player skill profiles through the REAL ride
## economy: PassengerSatisfaction, RideResult fares, RidePayout, JobTiers,
## CareerProfile purchases (buy the cheapest affordable upgrade). Telemetry
## is synthesised per skill level (pace vs. the passenger's expectation,
## collisions, near misses, hard brakes, pedestrian danger, failures).
## Exits non-zero if the pacing targets are missed.

const RIDES := 500
const ROUTES := [380.0, 420.0, 470.0, 520.0, 600.0, 650.0, 720.0]  # Fort–Pettah offer distances (m)

## [name, pace × passenger expectation, collisions/ride, major share,
##  close calls/ride, tight gaps/ride, hard brakes/ride, ped danger chance, fail chance]
const PLAYERS := [
	["poor", 0.72, 1.3, 0.3, 0.6, 0.1, 2.5, 0.25, 0.14],
	["average", 0.95, 0.5, 0.15, 1.4, 0.3, 1.2, 0.08, 0.06],
	["good", 1.1, 0.2, 0.1, 2.2, 0.6, 0.5, 0.03, 0.02],
	["excellent", 1.25, 0.05, 0.0, 3.0, 1.0, 0.15, 0.0, 0.005],
]

var econ: EconomyConfig
var ride_cfg: RideConfig
var profiles: Array[PassengerProfile] = []
var _fail := 0
var _report := PackedStringArray()


func _initialize() -> void:
	econ = load("res://resources/economy/economy_config.tres")
	ride_cfg = load("res://resources/rides/ride_config.tres")
	for id in ["rushed", "careful", "thrill_seeker"]:
		profiles.append(load("res://resources/passengers/%s.tres" % id))
	_report.append("# Economy simulation (v0.04)\n")
	_report.append("Deterministic, %d rides per player profile, buy-cheapest-affordable policy. Generated by `tests/sim/economy_sim.gd`.\n" % RIDES)
	_report.append("Costs per level: %s; starting cash Rs. %d.\n" % [str(UpgradeCatalog.get_def(&"engine").costs), econ.starting_cash])
	_report.append("| Player | Rs./ride | ★/ride | 1st upgrade (ride) | 2nd upgrade | Level 2 | Level 3 | Level 4 | Level 5 | First L5 category | All 20 levels | Cash @ 50 / 100 rides |")
	_report.append("|---|---|---|---|---|---|---|---|---|---|---|---|")
	var results := {}
	for p: Array in PLAYERS:
		results[p[0]] = _simulate(p)
	_check_targets(results)
	var text := "\n".join(_report)
	print(text)
	if "--write-report" in OS.get_cmdline_user_args():
		var f := FileAccess.open("res://docs/economy_simulation.md", FileAccess.WRITE)
		f.store_string(text + "\n")
		f.close()
	print("\nECONOMY SIM: %s (%d failures)" % ["PASS" if _fail == 0 else "FAIL", _fail])
	quit(1 if _fail > 0 else 0)


func _poisson(rng: RandomNumberGenerator, mean: float) -> int:
	var l := exp(-mean)
	var k := 0
	var p := 1.0
	while true:
		p *= rng.randf()
		if p <= l:
			return k
		k += 1
	return k


func _simulate(p: Array, seed_value: int = -1, rides: int = RIDES, report := true) -> Dictionary:
	var rng := RandomNumberGenerator.new()
	rng.seed = (hash(p[0]) & 0x7fffffff) if seed_value < 0 else seed_value
	var career := CareerProfile.new({}, econ)
	var r := {"name": p[0], "first": -1, "second": -1, "levels": {}, "first_l5": -1, "all_max": -1, "cash50": 0, "cash100": 0,
			"cash_sum": 0, "rep_sum": 0, "successes": 0, "purchases": 0}
	for ride in range(1, rides + 1):
		var profile: PassengerProfile = profiles[rng.randi() % profiles.size()]
		var tier := JobTiers.roll(career.career_level(), rng, econ)
		var tp := JobTiers.profile_for(profile, tier, econ)
		var route: float = ROUTES[rng.randi() % ROUTES.size()]
		var t := RideTelemetry.new()
		var pace: float = p[1] * rng.randf_range(0.85, 1.15)
		var kmh := tp.expected_speed_kmh * pace
		t.add_time_at(kmh, route / (kmh / 3.6))
		t.collisions = _poisson(rng, p[2])
		t.major_collisions = mini(t.collisions, _poisson(rng, p[2] * p[3]))
		t.close_calls = _poisson(rng, p[4])
		t.tight_gaps = _poisson(rng, p[5])
		t.combo_peak = t.close_calls + t.tight_gaps
		t.hard_brakes = _poisson(rng, p[6])
		t.pedestrian_danger = 1 if rng.randf() < p[7] else 0
		var failed: bool = rng.randf() < p[8]
		var res := RideResult.new()
		res.outcome = RideResult.Outcome.FAILED if failed else RideResult.Outcome.COMPLETED
		res.profile = tp
		res.route_distance_m = route
		res.telemetry = t
		res.satisfaction = PassengerSatisfaction.evaluate(t, tp, route, ride_cfg)
		if not failed:
			res.base_fare = RideResult.calculate_base_fare(route, ride_cfg)
			res.adjustment = RideResult.calculate_adjustment(res.base_fare, res.satisfaction.final_score, ride_cfg)
			res.final_fare = maxi(res.base_fare + res.adjustment, 0)
		RidePayout.apply(res, tier, career.career_level(), econ)
		career.apply_ride(res)
		if OS.has_environment("SIM_DEBUG") and ride <= 8 and p[0] == "average":
			print("[sim] ride %d %s %s route %d sat %.0f %s: Rs. %d (%s) cash %d" % [ride, profile.id, JobTiers.Tier.keys()[tier], route, res.satisfaction.final_score,
					"FAILED" if failed else "ok", res.cash_earned, str(res.payout_lines), career.cash()])
		if not failed:
			r["successes"] = int(r["successes"]) + 1
			r["cash_sum"] = int(r["cash_sum"]) + res.cash_earned
			r["rep_sum"] = int(r["rep_sum"]) + res.reputation_earned
		for lvl in range(2, 6):
			if not (r["levels"] as Dictionary).has(lvl) and career.career_level() >= lvl:
				r["levels"][lvl] = ride
		# Buy the cheapest affordable upgrade(s).
		while true:
			var best: StringName = &""
			var best_cost := -1
			for id in UpgradeCatalog.IDS:
				var cost := career.next_cost(id)
				if cost > 0 and cost <= career.cash() and (best_cost < 0 or cost < best_cost):
					best = id
					best_cost = cost
			if best_cost < 0:
				break
			career.purchase(best, career.level_of(best))
			r["purchases"] = int(r["purchases"]) + 1
			if int(r["purchases"]) == 1:
				r["first"] = ride
			elif int(r["purchases"]) == 2:
				r["second"] = ride
			if career.level_of(best) == 5 and int(r["first_l5"]) < 0:
				r["first_l5"] = ride
		var maxed := true
		for id in UpgradeCatalog.IDS:
			maxed = maxed and career.level_of(id) == 5
		if maxed and int(r["all_max"]) < 0:
			r["all_max"] = ride
		if ride == 50:
			r["cash50"] = int(career.data["total_earned"])
		if ride == 100:
			r["cash100"] = int(career.data["total_earned"])
	if not report:
		return r
	var s := maxf(float(r["successes"]), 1.0)
	var lv: Dictionary = r["levels"]
	_report.append("| %s | %d | %.1f | %s | %s | %s | %s | %s | %s | %s | %s | Rs. %s / %s |" % [p[0], roundi(float(r["cash_sum"]) / s), float(r["rep_sum"]) / s,
			_r(r["first"]), _r(r["second"]), _r(lv.get(2, -1)), _r(lv.get(3, -1)), _r(lv.get(4, -1)), _r(lv.get(5, -1)), _r(r["first_l5"]),
			_r(r["all_max"]), EconomyFormat.group(int(r["cash50"])), EconomyFormat.group(int(r["cash100"]))])
	return r


func _r(v: Variant) -> String:
	return "—" if int(v) < 0 else str(int(v))


func _check(label: String, ok: bool, detail: String) -> void:
	print("  [%s] %s  %s" % ["PASS" if ok else "FAIL", label, detail])
	_report.append("- %s **%s** — %s" % [label, "PASS" if ok else "FAIL", detail])
	if not ok:
		_fail += 1


## Median first / second upgrade ride over many seeded careers (one
## seed is too noisy to judge pacing).
func _median_pacing(p: Array, careers: int = 200) -> Vector2i:
	var firsts: Array[int] = []
	var gaps: Array[int] = []
	for i in careers:
		var r := _simulate(p, 1000 + i * 7919, 40, false)
		firsts.append(int(r["first"]) if int(r["first"]) > 0 else 99)
		gaps.append(int(r["second"]) - int(r["first"]) if int(r["second"]) > 0 else 99)
	firsts.sort()
	gaps.sort()
	return Vector2i(firsts[careers / 2], gaps[careers / 2])


func _check_targets(results: Dictionary) -> void:
	_report.append("\n## Pacing targets (medians over 200 seeded careers)\n")
	_report.append("| Player | median 1st upgrade (ride) | median rides from 1st to 2nd |")
	_report.append("|---|---|---|")
	var med := {}
	for p: Array in PLAYERS:
		med[p[0]] = _median_pacing(p)
		_report.append("| %s | %d | %d |" % [p[0], med[p[0]].x, med[p[0]].y])
	_report.append("")
	for name in ["average", "good"]:
		var m: Vector2i = med[name]
		_check("%s player: first upgrade within 2–4 rides (median)" % name, m.x >= 2 and m.x <= 4, "ride %d" % m.x)
		_check("%s player: second upgrade within another 3–5 rides (median)" % name, m.y >= 3 and m.y <= 5, "+%d rides" % m.y)
	var poor: Dictionary = results["poor"]
	var ex: Dictionary = results["excellent"]
	_check("better driving earns more (excellent > good > average > poor Rs./ride)",
			int(ex["cash_sum"]) / maxi(int(ex["successes"]), 1) > int(results["good"]["cash_sum"]) / maxi(int(results["good"]["successes"]), 1)
			and int(results["good"]["cash_sum"]) / maxi(int(results["good"]["successes"]), 1) > int(results["average"]["cash_sum"]) / maxi(int(results["average"]["successes"]), 1)
			and int(results["average"]["cash_sum"]) / maxi(int(results["average"]["successes"]), 1) > int(poor["cash_sum"]) / maxi(int(poor["successes"]), 1), "monotonic")
	_check("nobody maxes everything within 100 rides", int(ex["all_max"]) < 0 or int(ex["all_max"]) > 100, "excellent: %s" % _r(ex["all_max"]))
	_check("a poor driver still progresses (median first upgrade within 10 rides)", (med["poor"] as Vector2i).x <= 10, "ride %d" % (med["poor"] as Vector2i).x)
	_check("career level 2 within ~6–25 rides for an average driver", (results["average"]["levels"] as Dictionary).get(2, 999) <= 25, "ride %s" % _r((results["average"]["levels"] as Dictionary).get(2, -1)))
	_check("STREET LEGEND is a long-term goal (> 60 rides even for excellent)", (ex["levels"] as Dictionary).get(5, 999) > 60, "ride %s" % _r((ex["levels"] as Dictionary).get(5, -1)))
